# Puerto en el que se ejecutará el servidor HTTP
PORT=3000

# Cadena de conexión a la base de datos PostgreSQL (Sequelize)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_base_datos

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_secreta
